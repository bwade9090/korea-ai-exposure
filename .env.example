# Copy to .env and fill in. .env is gitignored and must never be committed.

# KOSIS OpenAPI key (https://kosis.kr/openapi/). Used from Phase 1 onward.
KOSIS_API_KEY=

# User-Agent for bls.gov downloads, with contact details, for example "Jane Doe jane@example.org".
# BLS refuses scripted requests that carry no contact information.
BLS_USER_AGENT=
